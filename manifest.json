{
  "manifest_version": 3,
  "name": "Gemini Highlighter Tool",
  "version": "1.0",
  "description": "Allows you to highlight and color-code text on Gemini.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://gemini.google.com/*"
  ],
  "action": {
    "default_title": "Gemini Highlight Tool",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}